__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# Safety guard, not a fetch step. The Advanced lab reads its data straight from
# S3 now, so no CSV under wcd-originals/ is ever meant to be committed -- but
# leftover downloads from the old offline arrangement may still be on disk, and
# one of them is 94 MB. This stops `git add -A` from staging them.
*/exercises/wcd-originals/*.csv
*/solutions/wcd-originals/*.csv
solutions/*/wcd-originals/*.csv

# week4_day2_afternoon's notebooks SCAFFOLD a dbt project under demo/ at runtime
# (the written models, dbt_packages/, target/, logs/). That is ephemeral student
# work -- the committed reference is week4_day2_afternoon/solutions/dbt-project/.
# NB: these patterns deliberately do NOT match .../solutions/dbt-project/demo/.
week4_day2_afternoon/exercises/demo/
week4_day2_afternoon/solutions/demo/
solutions/week4_day2_afternoon/demo/

# Running dbt against the committed project -- locally or in the console --
# drops build output beside it. None of it belongs in git, and none of it
# should be uploaded to Snowflake with the project either.
week4_day2_afternoon/dbt-project/demo/target/
week4_day2_afternoon/dbt-project/demo/logs/
week4_day2_afternoon/dbt-project/demo/dbt_packages/
week4_day2_afternoon/dbt-project/demo/package-lock.yml
week4_day2_afternoon/dbt-project/demo/.user.yml
